# StreamHub — ПРОМЕЖУТОЧНЫЙ .env
# Сформирован из переданного архива Twitch-chat.zip + локальные dev-секреты.
# ВАЖНО: файл содержит реальные Twitch credentials из архива. Не коммитить в Git.
# На первом запуске backend обязан валидировать legacy token через Twitch /validate.

# -----------------------------------------------------------------------------
# Project / runtime
# -----------------------------------------------------------------------------
PROJECT_NAME=streamhub
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
TZ=UTC

# -----------------------------------------------------------------------------
# Backend / API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_PORT=18741
PUBLIC_API_BASE_URL=http://localhost:18741
WEB_ORIGIN=http://localhost:18742
CORS_ALLOW_ORIGIN_REGEX=^(chrome-extension://[a-p]{32}|http://localhost:18742|http://127\.0\.0\.1:18742)$
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
INTERNAL_SERVICE_TOKEN=CHANGE_ME
SESSION_HMAC_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# MySQL 8.4
# -----------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=streamhub
MYSQL_USER=admin
MYSQL_PASSWORD=admin
MYSQL_ROOT_PASSWORD=admin
DATABASE_URL=mysql+asyncmy://admin:admin@mysql:3306/streamhub?charset=utf8mb4

# -----------------------------------------------------------------------------
# phpMyAdmin
# -----------------------------------------------------------------------------
PHPMYADMIN_HOST=mysql
PHPMYADMIN_PUBLIC_PORT=18743
PMA_HOST=mysql
PMA_PORT=3306
PMA_USER=admin
PMA_PASSWORD=admin

# -----------------------------------------------------------------------------
# Web UI
# -----------------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=3000
WEB_PUBLIC_PORT=18742
VITE_API_BASE_URL=http://localhost:18741

# -----------------------------------------------------------------------------
# Chrome extension
# -----------------------------------------------------------------------------
EXTENSION_API_BASE_URL=http://localhost:18741
EXTENSION_AUTOSTART_RECORDING=false
EXTENSION_CONTROL_RETRY_MAX=20
EXTENSION_CONTROL_RETRY_BASE_MS=500

# -----------------------------------------------------------------------------
# Twitch — values recovered from the supplied archive
# -----------------------------------------------------------------------------
TWITCH_CLIENT_ID=CHANGE_ME
TWITCH_CLIENT_SECRET=CHANGE_ME

# This token existed in the supplied archive/history. Treat it only as a bootstrap/legacy token.
# If /validate returns non-200, ignore it and use the authorization button (Device Code Flow).
TWITCH_LEGACY_OAUTH_TOKEN=CHANGE_ME
TWITCH_USE_LEGACY_TOKEN_IF_VALID=true

# New StreamHub authorization flow. EventSub + IRC redundancy scopes.
TWITCH_DEVICE_SCOPES=user:read:chat chat:read
TWITCH_IRC_FALLBACK_SCOPES=chat:read
TWITCH_VALIDATE_URL=https://id.twitch.tv/oauth2/validate
TWITCH_DEVICE_URL=https://id.twitch.tv/oauth2/device
TWITCH_TOKEN_URL=https://id.twitch.tv/oauth2/token
TWITCH_API_BASE_URL=https://api.twitch.tv/helix
TWITCH_EVENTSUB_WS_URL=wss://eventsub.wss.twitch.tv/ws
TWITCH_IRC_HOST=irc.chat.twitch.tv
TWITCH_IRC_PORT=6697
TWITCH_IRC_USE_TLS=true

# -----------------------------------------------------------------------------
# Ingest / playback
# -----------------------------------------------------------------------------
PROVIDER_OUTBOX_BATCH_MAX=500
PROVIDER_OUTBOX_FLUSH_MS=500
PROVIDER_OUTBOX_MAX_MESSAGES=250000
INGEST_BATCH_MAX=500
INGEST_MAX_BODY_BYTES=1048576
INGEST_DEDUP_WINDOW_SECONDS=86400
PLAYBACK_PAGE_SIZE=500
PLAYBACK_PREFETCH_MS=15000
SOFT_DELETE_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Optional future infrastructure. Disabled in MVP; variables are reserved.
# -----------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
MESSAGE_BROKER_ENABLED=false
MESSAGE_BROKER_URL=

# -----------------------------------------------------------------------------
# v1.2 — internal service topology / completeness / token encryption
# -----------------------------------------------------------------------------
CHAT_INGEST_HOST=chat-ingest
CHAT_INGEST_PORT=8001
CHAT_INGEST_BASE_URL=http://chat-ingest:8001
TWITCH_ADAPTER_HOST=twitch-adapter
TWITCH_ADAPTER_PORT=8002
TWITCH_ADAPTER_BASE_URL=http://twitch-adapter:8002
OAUTH_TOKEN_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
SESSION_HEARTBEAT_INTERVAL_SECONDS=10
SESSION_HEARTBEAT_TIMEOUT_SECONDS=30
SESSION_LATE_EVENT_GRACE_SECONDS=5

# -----------------------------------------------------------------------------
# Lossless capture policy (v1.2)
# -----------------------------------------------------------------------------
CAPTURE_REQUIRE_COMPLETE=true
LIVE_EVENTSUB_ENABLED=true
LIVE_IRC_REDUNDANCY_ENABLED=true
LIVE_POST_STREAM_VOD_RECONCILIATION=true
LIVE_ALLOW_COMPLETE_WITH_KNOWN_GAPS=false

# Full VOD replay-chat fetch. This is an isolated Twitch provider adapter.
VOD_FULL_CHAT_ENABLED=true
VOD_REPLAY_GQL_URL=https://gql.twitch.tv/gql
VOD_REPLAY_OPERATION_NAME=VideoCommentsByOffsetOrCursor
VOD_REPLAY_PERSISTED_QUERY_SHA256=b70a3591ff0f4e0313d126c6a1502d79a1c02baebb288227c582044aa76adf6a
VOD_REPLAY_CLIENT_ID=kimne78kx3ncx6brgo4mv6wki5h1ko
VOD_REPLAY_START_OFFSET_SECONDS=0
VOD_REPLAY_PAGE_CONCURRENCY=1
VOD_REPLAY_REQUEST_TIMEOUT_SECONDS=20
VOD_REPLAY_RETRY_MAX=20
VOD_REPLAY_RETRY_BASE_SECONDS=2
VOD_REPLAY_RETRY_MAX_SECONDS=120
VOD_REPLAY_CHECKPOINT_EVERY_PAGES=1
VOD_REPLAY_REQUIRE_END_OF_PAGINATION=true
VOD_REPLAY_DOM_FALLBACK_CAN_MARK_COMPLETE=false

# -----------------------------------------------------------------------------
# v1.3 — Video Recorder + spool/output
# -----------------------------------------------------------------------------
VIDEO_RECORDER_BASE_URL=http://video-recorder:8003
# REQUIRED: absolute host path on the physical output disk.
# Windows: use forward slashes, for example D:/StreamHub/output.
# There is intentionally no project-relative fallback.
VIDEO_OUTPUT_ROOT_1_HOST=D:/StreamHub/output
VIDEO_OUTPUT_ROOT_1_LABEL=D: output
# Extra roots remain disabled until matching absolute bind mounts are explicitly added.
VIDEO_OUTPUT_ROOT_2_LABEL=root2
VIDEO_OUTPUT_ROOT_2_ENABLED=false
VIDEO_OUTPUT_ROOT_3_LABEL=root3
VIDEO_OUTPUT_ROOT_3_ENABLED=false
VIDEO_ARCHIVE_BATCH_SEGMENTS=100
VIDEO_SPOOL_ROOT=/spool
VIDEO_SEGMENT_SECONDS=10
VIDEO_STREAM_QUALITY=best
VIDEO_RECONNECT_SECONDS=5
VIDEO_STREAM_TIMEOUT_SECONDS=90
VIDEO_STOP_TIMEOUT_SECONDS=20
VIDEO_STORAGE_COPY_WORKERS=1
VIDEO_ARCHIVE_RETRY_SECONDS=5
VIDEO_SPOOL_MIN_FREE_BYTES=536870912
VIDEO_ARCHIVE_MIN_FREE_BYTES=1073741824
