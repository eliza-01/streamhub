+                expected_bytes=source_log.stat().st_size,
+                min_free_bytes=0,
+            )
+        except Exception:
+            logger.exception("failed archiving recorder log session=%s", session_id)
+            return
+    try:
+        await asyncio.to_thread(shutil.rmtree, spool_root)
+    except FileNotFoundError:
