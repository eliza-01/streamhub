@@ -1,14 +1,14 @@
 -- Canonical death playback contract.
 --
--- Do not infer an animation "last frame" from 24/30/60 FPS and do not stop at
--- Length - epsilon. For a KeyframeSequence Roblox defines the sequence length
--- from the Keyframe with the greatest Keyframe.Time, so AnimationTrack.Length
--- is the authored final key time once the track is loaded.
+-- Death is allowed to play normally until the next Animator step would reach
+-- or cross AnimationTrack.Length. At that PreAnimation edge we do NOT seek to
+-- Length: imported clips can contain an exporter/runtime terminal sample that is
+-- not the corpse pose the player just saw (especially when root-bone motion is
+-- involved). Seeking to it makes DeathIdle visibly snap the corpse.
 --
--- We let the one-shot run normally. PreAnimation only intercepts the animation
--- step that would cross the end: while the track is still playing, freeze its
--- speed and evaluate TimePosition == Length exactly. That applies the actual
--- final authored key and keeps that pose alive for DeathIdle.
+-- Instead, freeze the track at its current TimePosition. That is the last pose
+-- Roblox has already evaluated and rendered, so the transition into DeathIdle is
+-- pose-continuous and independent of the source/export frame rate.
 local DeathAnimationPolicy = {}
 
 function DeathAnimationPolicy.Start(track: AnimationTrack)
@@ -19,29 +19,29 @@
 	track:AdjustWeight(1, 0)
 end
 
-function DeathAnimationPolicy.AdvanceToFinalKey(track: AnimationTrack, deltaTimeSim: number): (boolean, number?)
+function DeathAnimationPolicy.LatchVisibleTerminalPose(track: AnimationTrack, deltaTimeSim: number): (boolean, number?)
 	if not track.IsPlaying then
 		return false, nil
 	end
 
-	local finalKeyTime = tonumber(track.Length) or 0
+	local length = tonumber(track.Length) or 0
 	local speed = tonumber(track.Speed) or 0
-	if finalKeyTime <= 0 or speed <= 0 then
+	if length <= 0 or speed <= 0 then
 		return false, nil
 	end
 
 	local current = math.max(0, tonumber(track.TimePosition) or 0)
 	local step = math.max(0, tonumber(deltaTimeSim) or 0) * speed
-	if current + step < finalKeyTime then
-		return false, finalKeyTime
+	if current + step < length then
+		return false, current
 	end
 
-	-- TimePosition can only be changed while the track is playing. Freeze first,
-	-- then evaluate the exact final key instead of an FPS-derived approximation.
+	-- PreAnimation runs before Animator advances this frame. Freezing now keeps
+	-- the exact pose that was visible on the previous rendered frame. Do not seek
+	-- to Length here: that terminal sample may restore root-bone orientation.
 	track:AdjustSpeed(0)
-	track.TimePosition = finalKeyTime
 	track:AdjustWeight(1, 0)
-	return true, finalKeyTime
+	return true, current
 end
 
 return table.freeze(DeathAnimationPolicy)
