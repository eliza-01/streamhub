+async def _comment_reaction_state(
+    db: AsyncSession,
+    comment_ids: list[int],
+    viewer_user_id: uuid.UUID | None,
+) -> tuple[dict[int, dict[str, int]], dict[int, str]]:
+    if not comment_ids:
