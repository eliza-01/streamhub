+.active-tab { font-weight: 700; border-color: #7c8798; }
+.danger { color: #a11919; border-color: #e4baba; }
+.danger:hover:not(:disabled) { border-color: #c55b5b; }
+.subtle { padding: 7px 10px; }
+.capture-progress { margin-top: 14px; }
+.capture-progress-head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 6px; color: #4b5563; font-size: 12px; font-variant-numeric: tabular-nums; }
+.progress-track { position: relative; height: 7px; overflow: hidden; border-radius: 999px; background: #e7eaf0; }
+.progress-fill { height: 100%; border-radius: inherit; background: #596579; transition: width .25s linear; }
+.progress-track.indeterminate .progress-fill { width: 35%; animation: progress-slide 1.8s linear infinite; }
+@keyframes progress-slide { from { transform: translateX(-120%); } to { transform: translateX(340%); } }
 .player-controls { margin: 18px 0; background: white; padding: 14px; border-radius: 12px; }
 .player-controls input[type="range"] { flex: 1; min-width: 180px; }
 .chat { height: 62vh; overflow: auto; background: #111317; color: #f4f4f5; padding: 14px; border-radius: 12px; }
 .message { display: grid; grid-template-columns: 82px 160px 1fr; gap: 10px; padding: 4px 0; }
 .time { color: #8c95a5; font-variant-numeric: tabular-nums; }
+
+@media (max-width: 760px) {
+  main { padding: 18px; }
+  header, .detail-header, .player-controls { align-items: stretch; flex-direction: column; }
+  .actions { flex-wrap: wrap; justify-content: flex-start; }
+  .message { grid-template-columns: 72px 110px 1fr; }
+}
